# Copy to .env.local and fill in. Never commit real values.

# PostgreSQL (EU region in production)
DATABASE_URL=postgres://amigo:amigo@localhost:5432/amigo_invisible?max=5

# At least 32 random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# Email. Use SMTP or Resend; without either, emails are printed to the console (development only).
# Gmail SMTP: needs 2-step verification and an app password; EMAIL_FROM must be that Gmail address.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Resend (EU region) needs a verified domain to email anyone other than the account owner.
RESEND_API_KEY=
EMAIL_FROM="Amigo Invisible <no-reply@example.com>"

# Web Push. Generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Shared secret required by /api/cron/draws (sent as `Authorization: Bearer <CRON_SECRET>`)
CRON_SECRET=

# Public base URL used to build invitation and login links
APP_URL=http://localhost:3000
